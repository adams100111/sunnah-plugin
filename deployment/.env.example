# Required for private remote MCP access.
# Generate a strong value, for example:
#   openssl rand -hex 32
SUNNAH_MCP_TOKEN=

# Required only for canonical Quran Foundation-backed Qur'an lookup.
QURAN_FOUNDATION_CLIENT_ID=
QURAN_FOUNDATION_ACCESS_TOKEN=

# Optional independent semantic verifier.
# Leave both empty to use the built-in conservative verifier.
SUNNAH_VERIFIER_URL=
SUNNAH_VERIFIER_TOKEN=

# Runtime limits. Defaults below match the application defaults.
SUNNAH_MAX_REQUEST_BYTES=262144
SUNNAH_REQUEST_TIMEOUT_MS=60000
SUNNAH_RATE_LIMIT_PER_MINUTE=120
SUNNAH_RATE_LIMIT_MAX_KEYS=10000
